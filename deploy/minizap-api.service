[Unit]
Description=MiniZap potato replay API
After=network.target

[Service]
Type=simple
User=minizap
Group=minizap
WorkingDirectory=/srv/minizap/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3001
Environment=DB_PATH=/var/lib/minizap/flights.sqlite
Environment=GAME_ORIGIN=https://potatoe.minizap.online
Environment=ALLOWED_ORIGINS=https://potatoe.minizap.online
Environment=TRUST_PROXY=1
ExecStart=/opt/minizap/runtime/bin/node api/server.mjs
Restart=on-failure
RestartSec=3
StateDirectory=minizap
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/minizap
UMask=0077
MemoryMax=384M
CPUQuota=100%
TasksMax=64
CapabilityBoundingSet=
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
# The API performs no outbound network requests, including to co-hosted admin ports.
SystemCallFilter=~connect
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
