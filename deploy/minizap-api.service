[Unit]
Description=MiniZap potato replay API
After=network.target

[Service]
Type=simple
User=minizap
Group=minizap
WorkingDirectory=/srv/minizap/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3001
Environment=DB_PATH=/var/lib/minizap/flights.sqlite
Environment=GAME_ORIGIN=https://potatoe.minizap.online
Environment=ALLOWED_ORIGINS=https://potatoe.minizap.online
Environment=TRUST_PROXY=1
ExecStart=/opt/minizap/runtime/bin/node api/server.mjs
Restart=on-failure
RestartSec=3
StateDirectory=minizap
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/minizap
UMask=0077
MemoryMax=384M
CPUQuota=100%
TasksMax=64

[Install]
WantedBy=multi-user.target
