[Unit]
Description=Back up MiniZap replay database
After=minizap-api.service

[Service]
Type=oneshot
User=minizap
Group=minizap
WorkingDirectory=/srv/minizap/current
ExecStart=/bin/sh -c 'exec /opt/minizap/runtime/bin/node api/backup.mjs /var/lib/minizap/flights.sqlite /var/lib/minizap/backups/flights-$(date -u +%%Y-%%m-%%dT%%H%%M%%SZ).sqlite'
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/minizap/backups
UMask=0077
MemoryMax=128M
CPUQuota=25%
