[Unit]
Description=Back up MiniZap replay database
After=minizap-api.service

[Service]
Type=oneshot
User=minizap
Group=minizap
WorkingDirectory=/srv/minizap/current
ExecStart=/opt/minizap/runtime/bin/node api/daily-backup.mjs /var/lib/minizap/flights.sqlite /var/lib/minizap/backups
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/minizap/backups
UMask=0077
MemoryMax=128M
CPUQuota=25%
